diff --git a/include/linux/fmrd.h b/include/linux/fmrd.h
new file mode 100644
index 000000000..46ef7b0fa
--- /dev/null
+++ b/include/linux/fmrd.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_FMRD_H
+#define _LINUX_FMRD_H
+
+#include <linux/types.h>
+#include <linux/fs.h>
+#include <linux/path.h>
+#include <linux/stat.h>
+#include <linux/uidgid.h>
+#include <linux/resource.h>
+
+#define FMRD_UNTRUSTED_UID_MIN 10000
+#define FMRD_SPOOFED_DEV_UID 1000
+#define FMRD_SPOOFED_DEV_GID 1000
+
+enum fmrd_blocked_type {
+	FMRD_NOT_BLOCKED = 0,
+	FMRD_BLOCKED_EXACT_DATA_ADB = 1,
+	FMRD_BLOCKED_SUBPATH_OR_ZWC = 2,
+};
+
+#ifdef CONFIG_FMRD
+
+extern unsigned long fmrd_data_adb_ino;
+
+bool fmrd_is_data_root_dentry(struct dentry *base);
+bool fmrd_is_data_adb_path(const struct path *path);
+enum fmrd_blocked_type fmrd_adb_path_blocked_type(const struct filename *name);
+enum fmrd_blocked_type fmrd_fuse_zwc_check(const struct filename *name);
+int fmrd_spoof_devpts_stat(const struct path *path, struct kstat *stat,
+			   u32 request_mask, unsigned int query_flags);
+bool fmrd_should_hide_prio(int which, int who);
+
+#else /* !CONFIG_FMRD */
+
+static inline bool fmrd_is_data_root_dentry(struct dentry *base)
+{
+	return false;
+}
+static inline bool fmrd_is_data_adb_path(const struct path *path)
+{
+	return false;
+}
+static inline enum fmrd_blocked_type
+fmrd_adb_path_blocked_type(const struct filename *name)
+{
+	return FMRD_NOT_BLOCKED;
+}
+static inline enum fmrd_blocked_type
+fmrd_fuse_zwc_check(const struct filename *name)
+{
+	return FMRD_NOT_BLOCKED;
+}
+static inline int fmrd_spoof_devpts_stat(const struct path *path,
+					 struct kstat *stat, u32 request_mask,
+					 unsigned int query_flags)
+{
+	return -1;
+}
+static inline bool fmrd_should_hide_prio(int which, int who)
+{
+	return false;
+}
+
+#endif /* CONFIG_FMRD */
+
+#endif /* _LINUX_FMRD_H */
diff --git a/kernel/sys.c b/kernel/sys.c
index 4a87dc5fa..d59a1b713 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -74,6 +74,7 @@
 #include <linux/uaccess.h>
