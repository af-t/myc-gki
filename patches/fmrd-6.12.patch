diff --git a/fs/fmrd.c b/fs/fmrd.c
new file mode 100644
index 000000000..9558c727b
--- /dev/null
+++ b/fs/fmrd.c
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0
+#define pr_fmt(fmt) "fmrd: " fmt
+
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/magic.h>
+#include <linux/dcache.h>
+#include <linux/namei.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+#include <linux/resource.h>
+#include <linux/fmrd.h>
+
+#define SANITIZED_PATH_MAX 256
+#define RAW_PATH_SCAN_MAX 256
+#define MAX_PATH_COMPONENTS 128
+
+unsigned long fmrd_data_adb_ino;
+
+struct path_component {
+	unsigned short offset;
+	unsigned short length;
+	unsigned short raw_offset;
+	unsigned short raw_length;
+};
+
+static bool path_has_non_ascii_or_control(const char *raw)
+{
+	size_t i;
+
+	for (i = 0; i < RAW_PATH_SCAN_MAX && raw[i]; i++) {
+		unsigned char c = (unsigned char)raw[i];
+
+		if (c < 0x20 || c > 0x7E)
+			return true;
+	}
+	return false;
+}
+
+static bool str_contains_adb(const char *s)
+{
+	size_t i;
+
+	for (i = 0; i < RAW_PATH_SCAN_MAX - 3 && s[i]; i++) {
+		if (!s[i + 1] || !s[i + 2])
+			break;
+
+		if ((s[i] == 'a' || s[i] == 'A') &&
+		    (s[i + 1] == 'd' || s[i + 1] == 'D') &&
+		    (s[i + 2] == 'b' || s[i + 2] == 'B')) {
+			if ((i == 0 || s[i - 1] == '/') &&
+			    (s[i + 3] == '\0' || s[i + 3] == '/' ||
+			     (unsigned char)s[i + 3] <= 0x20 ||
+			     (unsigned char)s[i + 3] > 0x7E))
+				return true;
+		}
+	}
+	return false;
+}
+
+static bool component_eq(const char *path, const struct path_component *c,
+			 const char *lit, bool case_insensitive)
+{
+	size_t i;
+	size_t lit_len = strlen(lit);
+
+	if (c->length != lit_len)
+		return false;
+	for (i = 0; i < lit_len; i++) {
+		char a = path[c->offset + i];
+
+		if (case_insensitive && a >= 'A' && a <= 'Z')
+			a += 'a' - 'A';
+		if (a != lit[i])
+			return false;
+	}
+	return true;
+}
+
+static bool component_has_zwc(const char *start, size_t len)
+{
+	size_t i;
+
+	if (!start || !len)
+		return false;
+	for (i = 0; i < len; i++) {
+		unsigned char c = (unsigned char)start[i];
+
+		if (c <= 0x20 || c > 0x7E)
+			return true;
+	}
+	return false;
+}
+
+static int parse_path_components(const char *raw_path, char *path,
+				 struct path_component *comps, int max_comps,
+				 bool *saw_root_data_adb)
+{
+	const char *p = raw_path;
+	size_t di = 0;
+	int n = 0;
+
+	if (saw_root_data_adb)
+		*saw_root_data_adb = false;
+	if (!raw_path || !raw_path[0])
+		return 0;
+
+	while (*p) {
+		const char *raw_start;
+		size_t raw_len;
+		size_t comp_start_di;
+		size_t i;
+
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+
+		raw_start = p;
+		while (*p && *p != '/')
+			p++;
+		raw_len = (size_t)(p - raw_start);
+
+		if (raw_len == 1 && raw_start[0] == '.')
+			continue;
+		if (raw_len == 2 && raw_start[0] == '.' &&
+		    raw_start[1] == '.') {
+			if (n > 0) {
+				n--;
+				di = comps[n].offset;
+				path[di] = '\0';
+			}
+			continue;
+		}
+
+		if (n >= max_comps)
+			return n;
+
+		comp_start_di = di;
+		for (i = 0; i < raw_len; i++) {
+			unsigned char c = (unsigned char)raw_start[i];
+
+			if (c < 0x20 || c > 0x7E)
+				continue;
+			if (di + 1 >= SANITIZED_PATH_MAX)
+				break;
+			path[di++] = (char)c;
+		}
+		path[di] = '\0';
+
+		comps[n].offset = (unsigned short)comp_start_di;
+		comps[n].length = (unsigned short)(di - comp_start_di);
+		comps[n].raw_offset = (unsigned short)(raw_start - raw_path);
+		comps[n].raw_length = (unsigned short)raw_len;
+
+		if (saw_root_data_adb && raw_path[0] == '/' && n == 1 &&
+		    component_eq(path, &comps[0], "data", false) &&
+		    component_eq(path, &comps[1], "adb", true))
+			*saw_root_data_adb = true;
+
+		n++;
+	}
+
+	if (saw_root_data_adb && raw_path[0] == '/' && n >= 2 &&
+	    component_eq(path, &comps[0], "data", false) &&
+	    component_eq(path, &comps[1], "adb", true))
+		*saw_root_data_adb = true;
+
+	return n;
+}
+
+enum fmrd_blocked_type fmrd_adb_path_blocked_type(const struct filename *name)
+{
+	char path[SANITIZED_PATH_MAX];
+	struct path_component comps[MAX_PATH_COMPONENTS];
+	bool saw_root_data_adb = false;
+	int n;
+
+if (!name || IS_ERR(name) || !name->name || name->name[0] != '/')
+		return FMRD_NOT_BLOCKED;
+	if (!path_has_non_ascii_or_control(name->name) &&
+	    !str_contains_adb(name->name))
+		return FMRD_NOT_BLOCKED;
+
+	n = parse_path_components(name->name, path, comps, MAX_PATH_COMPONENTS,
+				  &saw_root_data_adb);
+	if (n <= 0)
+		return FMRD_NOT_BLOCKED;
+
+	if (n >= 2 && component_eq(path, &comps[0], "data", false) &&
+	    component_eq(path, &comps[1], "adb", true)) {
+		if (n == 2)
+			return FMRD_BLOCKED_EXACT_DATA_ADB;
+		return FMRD_BLOCKED_SUBPATH_OR_ZWC;
+	}
+
+	if (saw_root_data_adb)
+		return FMRD_BLOCKED_SUBPATH_OR_ZWC;
+
+	return FMRD_NOT_BLOCKED;
+}
+
+static enum fmrd_blocked_type
+get_blocked_type_for_untrusted(const char *raw_path)
+{
+	char path[SANITIZED_PATH_MAX];
+	struct path_component comps[MAX_PATH_COMPONENTS];
+	int n;
+	int i;
+
+	if (!raw_path || !raw_path[0])
+		return FMRD_NOT_BLOCKED;
+	if (!path_has_non_ascii_or_control(raw_path))
+		return FMRD_NOT_BLOCKED;
+
+	n = parse_path_components(raw_path, path, comps, MAX_PATH_COMPONENTS,
+				  NULL);
+	if (n <= 0)
+		return FMRD_NOT_BLOCKED;
+
+	for (i = 0; i < n; i++) {
+		if (component_eq(path, &comps[i], "android", true) &&
+		    i + 1 < n &&
+		    (component_eq(path, &comps[i + 1], "data", true) ||
+		     component_eq(path, &comps[i + 1], "obb", true) ||
+		     component_eq(path, &comps[i + 1], "media", true))) {
+			int start_idx = i;
+			int max_idx = (i + 2 < n) ? i + 2 : n - 1;
+			int k;
+
+			for (k = start_idx; k <= max_idx; k++) {
+				if (component_has_zwc(
+					    raw_path + comps[k].raw_offset,
+					    comps[k].raw_length))
+					return FMRD_BLOCKED_SUBPATH_OR_ZWC;
+			}
+		}
+	}
+
+	return FMRD_NOT_BLOCKED;
+}
+
+enum fmrd_blocked_type fmrd_fuse_zwc_check(const struct filename *name)
+{
+	if (!name || IS_ERR(name) || !name->name || !strchr(name->name, '/'))
+		return FMRD_NOT_BLOCKED;
+	if (!path_has_non_ascii_or_control(name->name))
+		return FMRD_NOT_BLOCKED;
+	return get_blocked_type_for_untrusted(name->name);
+}
+
+bool fmrd_is_data_root_dentry(struct dentry *base)
+{
+	struct super_block *sb;
+	struct dentry *parent;
+
+	if (!base || IS_ERR(base))
+		return false;
+
+	sb = base->d_sb;
+	if (!sb || IS_ERR(sb))
+		return false;
+
+	if (sb->s_magic != F2FS_SUPER_MAGIC && sb->s_magic != EXT4_SUPER_MAGIC)
+		return false;
+
+	if (base->d_parent == base)
+		return true;
+
+	parent = base->d_parent;
+	if (parent && parent->d_parent == parent && base->d_name.len == 4 &&
+	    ((base->d_name.name[0] | 0x20) == 'd') &&
+	    ((base->d_name.name[1] | 0x20) == 'a') &&
+	    ((base->d_name.name[2] | 0x20) == 't') &&
+	    ((base->d_name.name[3] | 0x20) == 'a'))
+		return true;
+
+	return false;
+}
+
+bool fmrd_is_data_adb_path(const struct path *path)
+{
+	struct dentry *dentry;
+
+	if (!path || IS_ERR(path))
+		return false;
+
+	dentry = path->dentry;
+	if (!dentry || IS_ERR(dentry))
+		return false;
+
+	if (dentry->d_name.len != 3 ||
+	    ((dentry->d_name.name[0] | 0x20) != 'a') ||
+	    ((dentry->d_name.name[1] | 0x20) != 'd') ||
+	    ((dentry->d_name.name[2] | 0x20) != 'b'))
+		return false;
+
+	if (fmrd_is_data_root_dentry(dentry->d_parent)) {
+		if (dentry->d_inode && !fmrd_data_adb_ino)
+			fmrd_data_adb_ino = dentry->d_inode->i_ino;
+		return true;
+	}
+
+	return false;
+}
+
+int fmrd_spoof_devpts_stat(const struct path *path, struct kstat *stat,
+			   u32 request_mask, unsigned int query_flags)
+{
+	struct dentry *dentry;
+	struct super_block *sb;
+	struct inode *inode;
+	int ret;
+
+	if (!path)
+		return -1;
+
+	dentry = path->dentry;
+	if (!dentry || IS_ERR(dentry))
+		return -1;
+
+	sb = dentry->d_sb;
+	if (!sb || IS_ERR(sb) || sb->s_magic != DEVPTS_SUPER_MAGIC)
+		return -1;
+
+	inode = d_backing_inode(dentry);
+	if (!inode || IS_ERR(inode))
+		return -1;
+
+	if (inode->i_uid.val != 0 && inode->i_gid.val != 0)
+		return -1;
+
+	ret = vfs_getattr_nosec(path, stat, request_mask, query_flags);
+	if (ret)
+		return ret;
+
+	if (stat->uid.val == 0)
+		stat->uid.val = FMRD_SPOOFED_DEV_UID;
+	if (stat->gid.val == 0)
+		stat->gid.val = FMRD_SPOOFED_DEV_GID;
+
+	return 0;
+}
+
+bool fmrd_should_hide_prio(int which, int who)
+{
+	uid_t caller_uid;
+
+	if (which != PRIO_USER || who < FMRD_UNTRUSTED_UID_MIN)
+		return false;
+
+	caller_uid = from_kuid(&init_user_ns, current_uid());
+	if (caller_uid < FMRD_UNTRUSTED_UID_MIN || who == (int)caller_uid ||
+	    ((unsigned int)who % 100000 == caller_uid % 100000))
+		return false;
+
+	return true;
+}
+
+MODULE_LICENSE("GPL");
